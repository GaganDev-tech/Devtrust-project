terraform {
  backend "s3" {
    bucket = "my-terraform-state-bucket"
    key    = "flask-app/terraform.tfstate"
    region = "us-east-1"
  }
}
resource "aws_instance" "app_server" {
tags = {
Name = "FlaskDevopsInstance"
}
ami = var.ubuntu_ami
instance_type = var.instance_type
vpc_security_group_ids = aws_security_group.app_sg.id
}

resource "aws_security_group" "app_sg" {
name= "flask_app_security_group"

ingress {
from_port = 22
to_port =  22
protocol = "tcp"
description = "ssh"
cidr_blocks = ["0.0.0.0/0"]
}

ingress {
from_port = 5000
to_port = 5000
protocol = "tcp"
cidr_blocks = ["0.0.0.0/0"]
}

egress {
    from_port        = 0
    to_port          = 0
    protocol         = "-1"
    cidr_blocks      = ["0.0.0.0/0"]
  }
}
